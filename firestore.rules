rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net (Default Deny)
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Global Hardened Primitives ---
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 256 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isPhoneAuthUser() {
      return isSignedIn()
        && request.auth.token.email is string
        && request.auth.token.email.lower().matches('^tel\\.[0-9]{7,15}@tel\\.schoolaria\\.app$');
    }

    function isVerifiedUser() {
      return isSignedIn()
        && request.auth.token.email is string
        && (
          request.auth.token.email_verified == true ||
          isPhoneAuthUser()
        );
    }

    function authEmail() {
      return request.auth.token.email.lower();
    }

    function safeEmailKey(email) {
      return email.lower().replace('[^a-z0-9_\\-]', '_');
    }

    function isAdmin() {
      return isVerifiedUser() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        authEmail() == 'smile.owx@gmail.com'
      );
    }

    function ownsExistingSchool(schoolId) {
      return isValidId(schoolId)
        && exists(/databases/$(database)/documents/schools/$(schoolId))
        && get(/databases/$(database)/documents/schools/$(schoolId)).data.ownerId == request.auth.uid;
    }

    function schoolBelongsToOwner(schoolId, docOwnerId) {
      return isValidId(schoolId)
        && exists(/databases/$(database)/documents/schools/$(schoolId))
        && get(/databases/$(database)/documents/schools/$(schoolId)).data.ownerId == docOwnerId;
    }

    function isStudentLockedEmailInSchool(schoolId, email) {
      return isValidId(schoolId)
        && email is string
        && email.size() >= 3
        && exists(/databases/$(database)/documents/studentLocks/$(('stulock_' + schoolId + '_' + safeEmailKey(email))));
    }

    function isStudentLockedInSchool(schoolId) {
      return isStudentLockedEmailInSchool(schoolId, authEmail());
    }

    function isCenseurInSchool(schoolId) {
      return isValidId(schoolId)
        && !isStudentLockedInSchool(schoolId)
        && exists(/databases/$(database)/documents/memberships/$(('mem_' + schoolId + '_censeur_' + safeEmailKey(authEmail()))));
    }

    function isSecretaireInSchool(schoolId) {
      return isValidId(schoolId)
        && !isStudentLockedInSchool(schoolId)
        && exists(/databases/$(database)/documents/memberships/$(('mem_' + schoolId + '_secretaire_' + safeEmailKey(authEmail()))));
    }

    function isManagementInSchool(schoolId) {
      return isCenseurInSchool(schoolId) || isSecretaireInSchool(schoolId);
    }

    function isMemberByDocId(schoolId) {
      return isValidId(schoolId) && (
        isCenseurInSchool(schoolId) ||
        isSecretaireInSchool(schoolId) ||
        (
          !isStudentLockedInSchool(schoolId) &&
          exists(/databases/$(database)/documents/memberships/$(('mem_' + schoolId + '_teacher_' + safeEmailKey(authEmail()))))
        ) ||
        exists(/databases/$(database)/documents/memberships/$(('mem_' + schoolId + '_parent_' + safeEmailKey(authEmail()))))
      );
    }

    function schoolDoc(schoolId) {
      return get(/databases/$(database)/documents/schools/$(schoolId)).data;
    }

    function canManageEnrollmentsInSchool(schoolId, docOwnerId) {
      return schoolBelongsToOwner(schoolId, docOwnerId) && (
        schoolDoc(schoolId).ownerId == request.auth.uid ||
        isSecretaireInSchool(schoolId)
      );
    }

    function canManageClassesInSchool(schoolId, docOwnerId) {
      return schoolBelongsToOwner(schoolId, docOwnerId) && (
        schoolDoc(schoolId).ownerId == request.auth.uid ||
        isCenseurInSchool(schoolId) ||
        isSecretaireInSchool(schoolId)
      );
    }

    function canManageStudentsInSchool(schoolId, docOwnerId) {
      return schoolBelongsToOwner(schoolId, docOwnerId) && (
        schoolDoc(schoolId).ownerId == request.auth.uid ||
        isManagementInSchool(schoolId)
      );
    }

    function canManagePedagogyInSchool(schoolId, docOwnerId) {
      return schoolBelongsToOwner(schoolId, docOwnerId) && (
        schoolDoc(schoolId).ownerId == request.auth.uid ||
        isCenseurInSchool(schoolId)
      );
    }

    function isRecipientCenseurInSchool(schoolId, email) {
      let sch = schoolDoc(schoolId);
      return email is string
        && email.size() >= 3
        && (
          ('censeurEmails' in sch && email in sch.censeurEmails) ||
          exists(/databases/$(database)/documents/memberships/$(('mem_' + schoolId + '_censeur_' + safeEmailKey(email))))
        );
    }

    function isRecipientDirectorInSchool(schoolId, email) {
      let sch = schoolDoc(schoolId);
      return email is string
        && email.size() >= 3
        && 'ownerEmail' in sch
        && sch.ownerEmail is string
        && sch.ownerEmail == email;
    }

    function isRecipientTeacherInSchool(schoolId, email) {
      let sch = schoolDoc(schoolId);
      return email is string
        && email.size() >= 3
        && (
          ('teacherEmails' in sch && email in sch.teacherEmails) ||
          exists(/databases/$(database)/documents/memberships/$(('mem_' + schoolId + '_teacher_' + safeEmailKey(email))))
        );
    }

    function allowedLeadershipEmails(schoolId) {
      let sch = schoolDoc(schoolId);
      let dirs = ('ownerEmail' in sch && sch.ownerEmail is string && sch.ownerEmail.size() >= 3) ? [sch.ownerEmail] : [];
      let cens = ('censeurEmails' in sch && sch.censeurEmails is list) ? sch.censeurEmails : [];
      return dirs.concat(cens);
    }

    function allowedSecretaireTargetEmails(schoolId) {
      let sch = schoolDoc(schoolId);
      let teas = ('teacherEmails' in sch && sch.teacherEmails is list) ? sch.teacherEmails : [];
      return allowedLeadershipEmails(schoolId).concat(teas);
    }

    function audienceOnlyCenseurTargets(schoolId, audience) {
      let sch = schoolDoc(schoolId);
      let cens = ('censeurEmails' in sch && sch.censeurEmails is list) ? sch.censeurEmails : [];
      return audience.size() >= 1 && (
        (cens.size() > 0 && audience.hasOnly(cens)) ||
        (audience.size() == 1 && isRecipientCenseurInSchool(schoolId, audience[0]))
      );
    }

    function audienceOnlyLeadershipTargets(schoolId, audience) {
      let allowed = allowedLeadershipEmails(schoolId);
      return audience.size() >= 1 && (
        (allowed.size() > 0 && audience.hasOnly(allowed)) ||
        (audience.size() == 1 && (isRecipientCenseurInSchool(schoolId, audience[0]) || isRecipientDirectorInSchool(schoolId, audience[0])))
      );
    }

    function audienceOnlySecretaireTargets(schoolId, audience) {
      let allowed = allowedSecretaireTargetEmails(schoolId);
      return audience.size() >= 1 && (
        (allowed.size() > 0 && audience.hasOnly(allowed)) ||
        (audience.size() == 1 && (
          isRecipientCenseurInSchool(schoolId, audience[0]) ||
          isRecipientDirectorInSchool(schoolId, audience[0]) ||
          isRecipientTeacherInSchool(schoolId, audience[0])
        ))
      );
    }

    function validStudentForWrite(studentId, schoolId, docOwnerId) {
      return isValidId(studentId)
        && exists(/databases/$(database)/documents/students/$(studentId))
        && get(/databases/$(database)/documents/students/$(studentId)).data.schoolId == schoolId
        && get(/databases/$(database)/documents/students/$(studentId)).data.ownerId == docOwnerId
        && (
          get(/databases/$(database)/documents/students/$(studentId)).data.ownerId == request.auth.uid ||
          isCenseurInSchool(schoolId) ||
          (
            !isStudentLockedInSchool(schoolId) &&
            'teacherEmails' in get(/databases/$(database)/documents/students/$(studentId)).data &&
            authEmail() in get(/databases/$(database)/documents/students/$(studentId)).data.teacherEmails
          )
        );
    }

    function studentParentEmailMatches(studentId, incomingData) {
      let stu = get(/databases/$(database)/documents/students/$(studentId)).data;
      let stuParent = ('parentEmail' in stu) ? stu.parentEmail : '';
      let incParent = ('parentEmail' in incomingData) ? incomingData.parentEmail : '';
      return stuParent == incParent;
    }

    function canWriteInSchool(schoolId, docOwnerId) {
      return schoolBelongsToOwner(schoolId, docOwnerId) && (
        schoolDoc(schoolId).ownerId == request.auth.uid ||
        ('memberEmails' in schoolDoc(schoolId) && authEmail() in schoolDoc(schoolId).memberEmails) ||
        isMemberByDocId(schoolId)
      );
    }

    function canStaffWriteInSchool(schoolId, docOwnerId) {
      return schoolBelongsToOwner(schoolId, docOwnerId) && (
        schoolDoc(schoolId).ownerId == request.auth.uid ||
        isCenseurInSchool(schoolId) ||
        isSecretaireInSchool(schoolId) ||
        (
          !isStudentLockedInSchool(schoolId) && (
            ('staffEmails' in schoolDoc(schoolId) && authEmail() in schoolDoc(schoolId).staffEmails) ||
            exists(/databases/$(database)/documents/memberships/$(('mem_' + schoolId + '_teacher_' + safeEmailKey(authEmail()))))
          )
        )
      );
    }

    function isNullableScore(val) {
      return val == null || ((val is int || val is float) && val >= 0 && val <= 20);
    }

    function isValidEmailList(list, maxSize) {
      return list is list && list.size() <= maxSize && (list.size() == 0 || list[0] is string);
    }

    function isValidStringList(list, maxSize) {
      return list is list && list.size() <= maxSize && (list.size() == 0 || list[0] is string);
    }

    // --- Validation Blueprints ---
    function isValidSchool(data) {
      return data.keys().hasAll(['ownerId', 'schoolName', 'adminName', 'academicYear', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['ownerId', 'schoolName', 'adminName', 'academicYear', 'endOfYearDate', 'motto', 'phone', 'email', 'address', 'city', 'registrationCode', 'theme', 'ownerEmail', 'censeurEmails', 'censeurNames', 'teacherEmails', 'memberEmails', 'staffEmails', 'createdAt', 'updatedAt'])
        && isValidId(data.ownerId)
        && data.schoolName is string && data.schoolName.size() >= 2 && data.schoolName.size() <= 120
        && data.adminName is string && data.adminName.size() >= 2 && data.adminName.size() <= 100
        && data.academicYear is string && data.academicYear.size() >= 4 && data.academicYear.size() <= 20
        && (!('endOfYearDate' in data) || (data.endOfYearDate is string && data.endOfYearDate.size() <= 20))
        && (!('motto' in data) || (data.motto is string && data.motto.size() <= 160))
        && (!('phone' in data) || (data.phone is string && data.phone.size() <= 30))
        && (!('email' in data) || (data.email is string && data.email.size() <= 120))
        && (!('address' in data) || (data.address is string && data.address.size() <= 160))
        && (!('city' in data) || (data.city is string && data.city.size() <= 80))
        && (!('registrationCode' in data) || (data.registrationCode is string && data.registrationCode.size() <= 60))
        && (!('theme' in data) || data.theme in ['violet', 'bleu', 'blanc', 'rouge', 'verte', 'orange', 'marron', 'gris'])
        && (!('ownerEmail' in data) || (data.ownerEmail is string && data.ownerEmail.size() <= 120))
        && (!('censeurEmails' in data) || isValidEmailList(data.censeurEmails, 20))
        && (!('censeurNames' in data) || isValidStringList(data.censeurNames, 20))
        && (!('teacherEmails' in data) || isValidEmailList(data.teacherEmails, 100))
        && (!('memberEmails' in data) || isValidEmailList(data.memberEmails, 100))
        && (!('staffEmails' in data) || isValidEmailList(data.staffEmails, 100))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidClassroom(data) {
      return data.keys().hasAll(['ownerId', 'schoolId', 'name', 'level', 'cycle', 'motif', 'accentColor', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['ownerId', 'schoolId', 'name', 'level', 'cycle', 'series', 'motif', 'accentColor', 'room', 'headTeacher', 'headTeacherEmail', 'slogan', 'closingDate', 'teacherEmails', 'memberEmails', 'managementEmails', 'createdAt', 'updatedAt'])
        && isValidId(data.ownerId)
        && isValidId(data.schoolId)
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 40
        && data.level is string && data.level.size() >= 1 && data.level.size() <= 30
        && data.cycle in ['Primaire', 'Collège', 'Lycée']
        && (!('series' in data) || (data.series is string && data.series.size() <= 40))
        && data.motif in ['maths-physique', 'lettres-philo', 'sciences-nat', 'general']
        && data.accentColor is string && data.accentColor.size() >= 1 && data.accentColor.size() <= 30
        && (!('room' in data) || (data.room is string && data.room.size() <= 40))
        && (!('headTeacher' in data) || (data.headTeacher is string && data.headTeacher.size() <= 80))
        && (!('headTeacherEmail' in data) || (data.headTeacherEmail is string && data.headTeacherEmail.size() <= 120))
        && (!('slogan' in data) || (data.slogan is string && data.slogan.size() <= 140))
        && (!('closingDate' in data) || (data.closingDate is string && data.closingDate.size() <= 20))
        && (!('teacherEmails' in data) || isValidEmailList(data.teacherEmails, 25))
        && (!('memberEmails' in data) || isValidEmailList(data.memberEmails, 100))
        && (!('managementEmails' in data) || isValidEmailList(data.managementEmails, 20))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidMembership(data) {
      return data.keys().hasAll(['ownerId', 'schoolId', 'memberEmail', 'memberName', 'role', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['ownerId', 'schoolId', 'memberEmail', 'memberName', 'role', 'assignedClasses', 'assignedSubject', 'childStudentIds', 'managementEmails', 'createdAt', 'updatedAt'])
        && isValidId(data.ownerId)
        && isValidId(data.schoolId)
        && data.memberEmail is string && data.memberEmail.size() >= 3 && data.memberEmail.size() <= 120
        && data.memberName is string && data.memberName.size() >= 2 && data.memberName.size() <= 100
        && data.role in ['censeur', 'secretaire', 'teacher', 'parent']
        && (!('assignedClasses' in data) || isValidStringList(data.assignedClasses, 25))
        && (!('assignedSubject' in data) || (data.assignedSubject is string && data.assignedSubject.size() <= 80))
        && (!('childStudentIds' in data) || isValidStringList(data.childStudentIds, 15))
        && (!('managementEmails' in data) || isValidEmailList(data.managementEmails, 20))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidStudent(data) {
      return data.keys().hasAll(['ownerId', 'schoolId', 'matricule', 'nom', 'prenoms', 'sexe', 'age', 'cycle', 'classe', 'status', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['ownerId', 'schoolId', 'matricule', 'nom', 'prenoms', 'sexe', 'age', 'cycle', 'classe', 'guardianName', 'guardianPhone', 'parentEmail', 'studentEmail', 'teacherEmails', 'managementEmails', 'status', 'createdAt', 'updatedAt'])
        && isValidId(data.ownerId)
        && isValidId(data.schoolId)
        && data.matricule is string && data.matricule.size() >= 2 && data.matricule.size() <= 30
        && data.nom is string && data.nom.size() >= 1 && data.nom.size() <= 80
        && data.prenoms is string && data.prenoms.size() >= 1 && data.prenoms.size() <= 100
        && data.sexe in ['M', 'F']
        && data.age is int && data.age >= 3 && data.age <= 30
        && data.cycle in ['Primaire', 'Collège', 'Lycée']
        && data.classe is string && data.classe.size() >= 1 && data.classe.size() <= 40
        && (!('guardianName' in data) || (data.guardianName is string && data.guardianName.size() <= 100))
        && (!('guardianPhone' in data) || (data.guardianPhone is string && data.guardianPhone.size() <= 30))
        && (!('parentEmail' in data) || (data.parentEmail is string && data.parentEmail.size() <= 120))
        && (!('studentEmail' in data) || (data.studentEmail is string && data.studentEmail.size() <= 120))
        && (!('teacherEmails' in data) || isValidEmailList(data.teacherEmails, 25))
        && (!('managementEmails' in data) || isValidEmailList(data.managementEmails, 20))
        && data.status in ['actif', 'archive']
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidStudentLock(data) {
      return data.keys().hasAll(['ownerId', 'schoolId', 'studentId', 'studentEmail', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['ownerId', 'schoolId', 'studentId', 'studentEmail', 'createdAt', 'updatedAt'])
        && isValidId(data.ownerId)
        && isValidId(data.schoolId)
        && isValidId(data.studentId)
        && data.studentEmail is string && data.studentEmail.size() >= 3 && data.studentEmail.size() <= 120
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidSubject(data) {
      return data.keys().hasAll(['ownerId', 'schoolId', 'name', 'cycle', 'coef', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['ownerId', 'schoolId', 'name', 'cycle', 'coef', 'teacherName', 'memberEmails', 'managementEmails', 'createdAt', 'updatedAt'])
        && isValidId(data.ownerId)
        && isValidId(data.schoolId)
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 80
        && data.cycle in ['Primaire', 'Collège', 'Lycée']
        && (data.coef is int || data.coef is float) && data.coef >= 1 && data.coef <= 10
        && (!('teacherName' in data) || (data.teacherName is string && data.teacherName.size() <= 80))
        && (!('memberEmails' in data) || isValidEmailList(data.memberEmails, 100))
        && (!('managementEmails' in data) || isValidEmailList(data.managementEmails, 20))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidGrade(data) {
      return data.keys().hasAll(['ownerId', 'schoolId', 'studentId', 'classe', 'subjectId', 'subjectName', 'coef', 'trimester', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['ownerId', 'schoolId', 'studentId', 'classe', 'subjectId', 'subjectName', 'coef', 'trimester', 'int1', 'int2', 'devoir', 'compo', 'appreciation', 'parentEmail', 'teacherEmails', 'managementEmails', 'createdAt', 'updatedAt'])
        && isValidId(data.ownerId)
        && isValidId(data.schoolId)
        && isValidId(data.studentId)
        && data.classe is string && data.classe.size() >= 1 && data.classe.size() <= 40
        && isValidId(data.subjectId)
        && data.subjectName is string && data.subjectName.size() >= 1 && data.subjectName.size() <= 80
        && (data.coef is int || data.coef is float) && data.coef >= 1 && data.coef <= 10
        && data.trimester is int && data.trimester >= 1 && data.trimester <= 3
        && (!('int1' in data) || isNullableScore(data.int1))
        && (!('int2' in data) || isNullableScore(data.int2))
        && (!('devoir' in data) || isNullableScore(data.devoir))
        && (!('compo' in data) || isNullableScore(data.compo))
        && (!('appreciation' in data) || (data.appreciation is string && data.appreciation.size() <= 200))
        && (!('parentEmail' in data) || (data.parentEmail is string && data.parentEmail.size() <= 120))
        && (!('teacherEmails' in data) || isValidEmailList(data.teacherEmails, 25))
        && (!('managementEmails' in data) || isValidEmailList(data.managementEmails, 20))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidBulletinRemark(data) {
      return data.keys().hasAll(['ownerId', 'schoolId', 'studentId', 'trimester', 'absences', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['ownerId', 'schoolId', 'studentId', 'trimester', 'absences', 'conduite', 'decision', 'generalRemark', 'parentEmail', 'teacherEmails', 'managementEmails', 'createdAt', 'updatedAt'])
        && isValidId(data.ownerId)
        && isValidId(data.schoolId)
        && isValidId(data.studentId)
        && data.trimester is int && data.trimester >= 1 && data.trimester <= 3
        && data.absences is int && data.absences >= 0 && data.absences <= 365
        && (!('conduite' in data) || (data.conduite is string && data.conduite.size() <= 60))
        && (!('decision' in data) || (data.decision is string && data.decision.size() <= 80))
        && (!('generalRemark' in data) || (data.generalRemark is string && data.generalRemark.size() <= 400))
        && (!('parentEmail' in data) || (data.parentEmail is string && data.parentEmail.size() <= 120))
        && (!('teacherEmails' in data) || isValidEmailList(data.teacherEmails, 25))
        && (!('managementEmails' in data) || isValidEmailList(data.managementEmails, 20))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidMessage(data) {
      return data.keys().hasAll(['ownerId', 'schoolId', 'senderUid', 'senderEmail', 'senderName', 'senderRole', 'recipientEmail', 'recipientName', 'subject', 'body', 'read', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['ownerId', 'schoolId', 'senderUid', 'senderEmail', 'senderName', 'senderRole', 'recipientEmail', 'recipientName', 'studentId', 'studentName', 'classe', 'subject', 'body', 'read', 'createdAt', 'updatedAt'])
        && isValidId(data.ownerId)
        && isValidId(data.schoolId)
        && isValidId(data.senderUid)
        && data.senderEmail is string && data.senderEmail.size() >= 3 && data.senderEmail.size() <= 120
        && data.senderName is string && data.senderName.size() >= 1 && data.senderName.size() <= 100
        && data.senderRole in ['admin', 'censeur', 'secretaire', 'teacher', 'parent']
        && data.recipientEmail is string && data.recipientEmail.size() >= 3 && data.recipientEmail.size() <= 120
        && data.recipientName is string && data.recipientName.size() >= 1 && data.recipientName.size() <= 100
        && (!('studentId' in data) || (data.studentId is string && data.studentId.size() <= 128))
        && (!('studentName' in data) || (data.studentName is string && data.studentName.size() <= 120))
        && (!('classe' in data) || (data.classe is string && data.classe.size() <= 40))
        && data.subject is string && data.subject.size() >= 1 && data.subject.size() <= 140
        && data.body is string && data.body.size() >= 1 && data.body.size() <= 2000
        && data.read is bool
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidNotification(data) {
      return data.keys().hasAll(['ownerId', 'schoolId', 'type', 'title', 'message', 'audienceEmails', 'createdByEmail', 'createdByName', 'read', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['ownerId', 'schoolId', 'type', 'title', 'message', 'targetClasse', 'studentId', 'audienceEmails', 'dismissedByEmails', 'managementEmails', 'createdByEmail', 'createdByName', 'createdByRole', 'read', 'expiresAt', 'createdAt', 'updatedAt'])
        && isValidId(data.ownerId)
        && isValidId(data.schoolId)
        && data.type in ['grade', 'absence', 'announcement']
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 140
        && data.message is string && data.message.size() >= 1 && data.message.size() <= 600
        && (!('targetClasse' in data) || (data.targetClasse is string && data.targetClasse.size() <= 40))
        && (!('studentId' in data) || (data.studentId is string && data.studentId.size() <= 128))
        && isValidEmailList(data.audienceEmails, 100)
        && (!('dismissedByEmails' in data) || isValidEmailList(data.dismissedByEmails, 100))
        && (!('managementEmails' in data) || isValidEmailList(data.managementEmails, 20))
        && data.createdByEmail is string && data.createdByEmail.size() >= 3 && data.createdByEmail.size() <= 120
        && data.createdByName is string && data.createdByName.size() >= 1 && data.createdByName.size() <= 100
        && (!('createdByRole' in data) || data.createdByRole in ['admin', 'censeur', 'secretaire', 'teacher', 'parent'])
        && data.read is bool
        && (!('expiresAt' in data) || data.expiresAt == null || data.expiresAt is timestamp)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidAcademicArchive(data) {
      return data.keys().hasAll(['ownerId', 'schoolId', 'academicYear', 'closedAtIso', 'closedByEmail', 'closedByName', 'totalStudents', 'promotedCount', 'repeatedCount', 'graduatedCount', 'withdrawnCount', 'classSummaries', 'studentRecords', 'createdAt'])
        && data.keys().hasOnly(['ownerId', 'schoolId', 'academicYear', 'closedAtIso', 'endOfYearDate', 'closedByEmail', 'closedByName', 'totalStudents', 'promotedCount', 'repeatedCount', 'graduatedCount', 'withdrawnCount', 'classSummaries', 'studentRecords', 'managementEmails', 'createdAt'])
        && isValidId(data.ownerId)
        && isValidId(data.schoolId)
        && data.academicYear is string && data.academicYear.size() >= 4 && data.academicYear.size() <= 20
        && data.closedAtIso is string && data.closedAtIso.size() >= 4 && data.closedAtIso.size() <= 40
        && (!('endOfYearDate' in data) || (data.endOfYearDate is string && data.endOfYearDate.size() <= 20))
        && data.closedByEmail is string && data.closedByEmail.size() >= 3 && data.closedByEmail.size() <= 120
        && data.closedByName is string && data.closedByName.size() >= 1 && data.closedByName.size() <= 100
        && data.totalStudents is int && data.totalStudents >= 0 && data.totalStudents <= 5000
        && data.promotedCount is int && data.promotedCount >= 0 && data.promotedCount <= 5000
        && data.repeatedCount is int && data.repeatedCount >= 0 && data.repeatedCount <= 5000
        && data.graduatedCount is int && data.graduatedCount >= 0 && data.graduatedCount <= 5000
        && data.withdrawnCount is int && data.withdrawnCount >= 0 && data.withdrawnCount <= 5000
        && data.classSummaries is list && data.classSummaries.size() <= 100
        && data.studentRecords is list && data.studentRecords.size() <= 3000
        && (!('managementEmails' in data) || isValidEmailList(data.managementEmails, 20))
        && data.createdAt is timestamp;
    }

    function isValidAuditLog(data) {
      return data.keys().hasAll(['ownerId', 'schoolId', 'weekKey', 'category', 'severity', 'action', 'details', 'actorUid', 'actorEmail', 'actorName', 'actorRole', 'createdAt'])
        && data.keys().hasOnly(['ownerId', 'schoolId', 'weekKey', 'category', 'severity', 'action', 'details', 'actorUid', 'actorEmail', 'actorName', 'actorRole', 'targetId', 'createdAt'])
        && isValidId(data.ownerId)
        && isValidId(data.schoolId)
        && data.weekKey is string && data.weekKey.matches('^[0-9]{4}-W[0-9]{2}$')
        && data.category in ['auth', 'student', 'grade', 'bulletin', 'classroom', 'subject', 'rbac', 'settings', 'security', 'export', 'archive']
        && data.severity in ['info', 'warning', 'critical']
        && data.action is string && data.action.size() >= 2 && data.action.size() <= 100
        && data.details is string && data.details.size() >= 1 && data.details.size() <= 500
        && isValidId(data.actorUid)
        && data.actorEmail is string && data.actorEmail.size() >= 3 && data.actorEmail.size() <= 120
        && data.actorName is string && data.actorName.size() >= 1 && data.actorName.size() <= 100
        && data.actorRole in ['admin', 'censeur', 'secretaire', 'teacher', 'parent']
        && (!('targetId' in data) || (data.targetId is string && data.targetId.size() <= 128))
        && data.createdAt is timestamp;
    }

    // --- Collection Match Blocks ---

    match /admins/{adminId} {
      allow get: if isVerifiedUser() && request.auth.uid == adminId;
      allow list, write: if false;
    }

    match /schools/{schoolId} {
      allow get: if isVerifiedUser() && isValidId(schoolId) && (
        existing().ownerId == request.auth.uid ||
        ('memberEmails' in existing() && authEmail() in existing().memberEmails) ||
        isMemberByDocId(schoolId) ||
        isAdmin()
      );
      allow list: if isVerifiedUser() && (
        resource.data.ownerId == request.auth.uid ||
        ('memberEmails' in resource.data && authEmail() in resource.data.memberEmails)
      );
      allow create: if isVerifiedUser()
        && isValidId(schoolId)
        && isValidSchool(incoming())
        && incoming().ownerId == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isVerifiedUser()
        && isValidId(schoolId)
        && isValidSchool(incoming())
        && incoming().ownerId == existing().ownerId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          isAdmin() ||
          (
            existing().ownerId == request.auth.uid &&
            incoming().diff(existing()).affectedKeys().hasOnly(['schoolName', 'adminName', 'academicYear', 'endOfYearDate', 'motto', 'phone', 'email', 'address', 'city', 'registrationCode', 'theme', 'ownerEmail', 'censeurEmails', 'censeurNames', 'teacherEmails', 'memberEmails', 'staffEmails', 'updatedAt'])
          ) ||
          (
            isCenseurInSchool(schoolId) &&
            incoming().diff(existing()).affectedKeys().hasOnly(['memberEmails', 'staffEmails', 'censeurEmails', 'censeurNames', 'teacherEmails', 'updatedAt'])
          )
        );
      allow delete: if isVerifiedUser() && isValidId(schoolId) && existing().ownerId == request.auth.uid;
    }

    match /classrooms/{classroomId} {
      allow get: if isVerifiedUser() && isValidId(classroomId) && (
        existing().ownerId == request.auth.uid ||
        isManagementInSchool(existing().schoolId) ||
        (!isStudentLockedInSchool(existing().schoolId) && 'teacherEmails' in existing() && authEmail() in existing().teacherEmails) ||
        ('memberEmails' in existing() && authEmail() in existing().memberEmails) ||
        isMemberByDocId(existing().schoolId) ||
        isAdmin()
      );
      allow list: if isVerifiedUser() && (
        resource.data.ownerId == request.auth.uid ||
        ('managementEmails' in resource.data && authEmail() in resource.data.managementEmails) ||
