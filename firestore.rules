      allow create: if isVerifiedUser()
        && isValidId(messageId)
        && isValidMessage(incoming())
        && incoming().senderUid == request.auth.uid
        && incoming().senderEmail == authEmail()
        && incoming().read == false
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && canWriteInSchool(incoming().schoolId, incoming().ownerId)
        && (
          (
            incoming().senderRole == 'parent' &&
            !isManagementInSchool(incoming().schoolId) &&
            isRecipientCenseurInSchool(incoming().schoolId, incoming().recipientEmail)
          ) ||
          (
            incoming().senderRole == 'teacher' &&
            canStaffWriteInSchool(incoming().schoolId, incoming().ownerId) &&
            !isManagementInSchool(incoming().schoolId) &&
            (
              isRecipientCenseurInSchool(incoming().schoolId, incoming().recipientEmail) ||
              isRecipientDirectorInSchool(incoming().schoolId, incoming().recipientEmail)
            )
          ) ||
          (
            incoming().senderRole == 'secretaire' &&
            isSecretaireInSchool(incoming().schoolId) &&
            (
              isRecipientCenseurInSchool(incoming().schoolId, incoming().recipientEmail) ||
              isRecipientDirectorInSchool(incoming().schoolId, incoming().recipientEmail) ||
              isRecipientTeacherInSchool(incoming().schoolId, incoming().recipientEmail)
            )
          ) ||
          (incoming().senderRole == 'censeur' && isCenseurInSchool(incoming().schoolId)) ||
