      );
    }

    match /memberships/{membershipId} {
      allow get: if isVerifiedUser() && isValidId(membershipId) && (
        existing().ownerId == request.auth.uid ||
        existing().memberEmail == authEmail() ||
        isManagementInSchool(existing().schoolId) ||
