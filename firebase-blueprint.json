{
  "entities": {
    "School": {
      "title": "School",
      "description": "Configuration complète de l'établissement scolaire et profil de l'administrateur.",
      "type": "object",
      "properties": {
        "ownerId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "schoolName": { "type": "string", "minLength": 2, "maxLength": 120 },
        "adminName": { "type": "string", "minLength": 2, "maxLength": 100 },
        "academicYear": { "type": "string", "minLength": 4, "maxLength": 20 },
        "endOfYearDate": { "type": "string", "minLength": 0, "maxLength": 20 },
        "motto": { "type": "string", "minLength": 0, "maxLength": 160 },
        "phone": { "type": "string", "minLength": 0, "maxLength": 30 },
        "email": { "type": "string", "minLength": 0, "maxLength": 120 },
        "address": { "type": "string", "minLength": 0, "maxLength": 160 },
        "city": { "type": "string", "minLength": 0, "maxLength": 80 },
        "registrationCode": { "type": "string", "minLength": 0, "maxLength": 60 },
        "theme": { "type": "string", "enum": ["violet", "bleu", "blanc", "rouge", "verte", "orange", "marron", "gris"] },
        "ownerEmail": { "type": "string", "minLength": 0, "maxLength": 120 },
        "censeurEmails": { "type": "array" },
        "censeurNames": { "type": "array" },
        "teacherEmails": { "type": "array" },
        "memberEmails": { "type": "array" },
        "staffEmails": { "type": "array" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["ownerId", "schoolName", "adminName", "academicYear", "createdAt", "updatedAt"]
    },
    "Classroom": {
      "title": "Classroom",
      "description": "Classe ou division personnalisée (ex: 6ème A, 4ème B, Tle D) avec thème, professeur principal et date de clôture.",
      "type": "object",
      "properties": {
        "ownerId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "schoolId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "name": { "type": "string", "minLength": 1, "maxLength": 40 },
        "level": { "type": "string", "minLength": 1, "maxLength": 30 },
        "cycle": { "type": "string", "enum": ["Primaire", "Collège", "Lycée"] },
        "series": { "type": "string", "minLength": 0, "maxLength": 40 },
        "motif": { "type": "string", "enum": ["maths-physique", "lettres-philo", "sciences-nat", "general"] },
        "accentColor": { "type": "string", "minLength": 1, "maxLength": 30 },
        "room": { "type": "string", "minLength": 0, "maxLength": 40 },
        "headTeacher": { "type": "string", "minLength": 0, "maxLength": 80 },
        "headTeacherEmail": { "type": "string", "minLength": 0, "maxLength": 120 },
        "slogan": { "type": "string", "minLength": 0, "maxLength": 140 },
        "closingDate": { "type": "string", "minLength": 0, "maxLength": 20 },
        "teacherEmails": { "type": "array" },
        "memberEmails": { "type": "array" },
        "managementEmails": { "type": "array" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["ownerId", "schoolId", "name", "level", "cycle", "motif", "accentColor", "createdAt", "updatedAt"]
    },
    "Membership": {
      "title": "Membership",
      "description": "Rattachement hiérarchique d'un censeur, secrétaire, enseignant ou parent à l'établissement.",
      "type": "object",
      "properties": {
        "ownerId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "schoolId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "memberEmail": { "type": "string", "minLength": 3, "maxLength": 120 },
        "memberName": { "type": "string", "minLength": 2, "maxLength": 100 },
        "role": { "type": "string", "enum": ["censeur", "secretaire", "teacher", "parent"] },
        "assignedClasses": { "type": "array" },
        "assignedSubject": { "type": "string", "minLength": 0, "maxLength": 80 },
        "childStudentIds": { "type": "array" },
        "managementEmails": { "type": "array" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["ownerId", "schoolId", "memberEmail", "memberName", "role", "createdAt", "updatedAt"]
    },
    "Student": {
      "title": "Student",
      "description": "Élève inscrit dans l'établissement avec classe/division, tuteur et accès parent/enseignant/direction.",
      "type": "object",
      "properties": {
        "ownerId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "schoolId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "matricule": { "type": "string", "minLength": 2, "maxLength": 30 },
        "nom": { "type": "string", "minLength": 1, "maxLength": 80 },
        "prenoms": { "type": "string", "minLength": 1, "maxLength": 100 },
        "sexe": { "type": "string", "enum": ["M", "F"] },
        "age": { "type": "integer" },
        "cycle": { "type": "string", "enum": ["Primaire", "Collège", "Lycée"] },
        "classe": { "type": "string", "minLength": 1, "maxLength": 40 },
        "guardianName": { "type": "string", "minLength": 0, "maxLength": 100 },
        "guardianPhone": { "type": "string", "minLength": 0, "maxLength": 30 },
        "parentEmail": { "type": "string", "minLength": 0, "maxLength": 120 },
        "studentEmail": { "type": "string", "minLength": 0, "maxLength": 120 },
        "teacherEmails": { "type": "array" },
        "managementEmails": { "type": "array" },
        "status": { "type": "string", "enum": ["actif", "archive"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["ownerId", "schoolId", "matricule", "nom", "prenoms", "sexe", "age", "cycle", "classe", "status", "createdAt", "updatedAt"]
    },
    "StudentLock": {
      "title": "StudentLock",
      "description": "Verrou d'identité empêchant un élève inscrit d'accéder à l'espace personnel du même établissement.",
      "type": "object",
      "properties": {
        "ownerId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "schoolId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "studentId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "studentEmail": { "type": "string", "minLength": 3, "maxLength": 120 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["ownerId", "schoolId", "studentId", "studentEmail", "createdAt", "updatedAt"]
    },
    "Subject": {
      "title": "Subject",
      "description": "Matière académique associée à un cycle et un coefficient.",
      "type": "object",
      "properties": {
        "ownerId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "schoolId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "name": { "type": "string", "minLength": 1, "maxLength": 80 },
        "cycle": { "type": "string", "enum": ["Primaire", "Collège", "Lycée"] },
        "coef": { "type": "number" },
        "teacherName": { "type": "string", "minLength": 0, "maxLength": 80 },
        "memberEmails": { "type": "array" },
        "managementEmails": { "type": "array" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["ownerId", "schoolId", "name", "cycle", "coef", "createdAt", "updatedAt"]
    },
    "Grade": {
      "title": "Grade",
      "description": "Relevé de notes (Interrogations, Devoir, Composition) par élève, matière et période (trimestre ou semestre).",
      "type": "object",
      "properties": {
        "ownerId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "schoolId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "studentId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "classe": { "type": "string", "minLength": 1, "maxLength": 40 },
        "subjectId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "subjectName": { "type": "string", "minLength": 1, "maxLength": 80 },
        "coef": { "type": "number" },
        "trimester": { "type": "integer" },
        "int1": { "type": "number" },
        "int2": { "type": "number" },
        "devoir": { "type": "number" },
        "compo": { "type": "number" },
        "appreciation": { "type": "string", "minLength": 0, "maxLength": 200 },
        "parentEmail": { "type": "string", "minLength": 0, "maxLength": 120 },
        "teacherEmails": { "type": "array" },
        "managementEmails": { "type": "array" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["ownerId", "schoolId", "studentId", "classe", "subjectId", "subjectName", "coef", "trimester", "createdAt", "updatedAt"]
    },
    "BulletinRemark": {
      "title": "BulletinRemark",
      "description": "Décision du conseil de classe, absences et appréciation générale du bulletin.",
      "type": "object",
      "properties": {
        "ownerId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "schoolId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "studentId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "trimester": { "type": "integer" },
        "absences": { "type": "integer" },
        "conduite": { "type": "string", "minLength": 0, "maxLength": 60 },
        "decision": { "type": "string", "minLength": 0, "maxLength": 80 },
        "generalRemark": { "type": "string", "minLength": 0, "maxLength": 400 },
        "parentEmail": { "type": "string", "minLength": 0, "maxLength": 120 },
        "teacherEmails": { "type": "array" },
        "managementEmails": { "type": "array" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["ownerId", "schoolId", "studentId", "trimester", "absences", "createdAt", "updatedAt"]
    },
    "Message": {
      "title": "Message",
      "description": "Message sécurisé entre direction, enseignants et parents d'élèves.",
      "type": "object",
      "properties": {
        "ownerId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "schoolId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "senderUid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "senderEmail": { "type": "string", "minLength": 3, "maxLength": 120 },
        "senderName": { "type": "string", "minLength": 1, "maxLength": 100 },
        "senderRole": { "type": "string", "enum": ["admin", "censeur", "secretaire", "teacher", "parent"] },
        "recipientEmail": { "type": "string", "minLength": 3, "maxLength": 120 },
        "recipientName": { "type": "string", "minLength": 1, "maxLength": 100 },
        "studentId": { "type": "string", "minLength": 0, "maxLength": 128 },
        "studentName": { "type": "string", "minLength": 0, "maxLength": 120 },
        "classe": { "type": "string", "minLength": 0, "maxLength": 40 },
        "subject": { "type": "string", "minLength": 1, "maxLength": 140 },
        "body": { "type": "string", "minLength": 1, "maxLength": 2000 },
        "read": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["ownerId", "schoolId", "senderUid", "senderEmail", "senderName", "senderRole", "recipientEmail", "recipientName", "subject", "body", "read", "createdAt", "updatedAt"]
    },
    "Notification": {
      "title": "Notification",
      "description": "Notification de note, absence ou annonce importante pour les parents et enseignants.",
      "type": "object",
      "properties": {
        "ownerId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "schoolId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "type": { "type": "string", "enum": ["grade", "absence", "announcement"] },
        "title": { "type": "string", "minLength": 1, "maxLength": 140 },
        "message": { "type": "string", "minLength": 1, "maxLength": 600 },
        "targetClasse": { "type": "string", "minLength": 0, "maxLength": 40 },
        "studentId": { "type": "string", "minLength": 0, "maxLength": 128 },
        "audienceEmails": { "type": "array" },
        "dismissedByEmails": { "type": "array" },
        "managementEmails": { "type": "array" },
        "createdByEmail": { "type": "string", "minLength": 3, "maxLength": 120 },
        "createdByName": { "type": "string", "minLength": 1, "maxLength": 100 },
        "createdByRole": { "type": "string", "enum": ["admin", "censeur", "secretaire", "teacher", "parent"] },
        "read": { "type": "boolean" },
        "expiresAt": { "type": ["string", "null"], "format": "date-time" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["ownerId", "schoolId", "type", "title", "message", "audienceEmails", "createdByEmail", "createdByName", "read", "createdAt", "updatedAt"]
    },
    "AcademicArchive": {
      "title": "AcademicArchive",
      "description": "Archive annuelle immuable issue d'une clôture d'année scolaire (bilans par classe et décisions individuelles).",
      "type": "object",
      "properties": {
        "ownerId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "schoolId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "academicYear": { "type": "string", "minLength": 4, "maxLength": 20 },
        "closedAtIso": { "type": "string", "minLength": 4, "maxLength": 40 },
        "endOfYearDate": { "type": "string", "minLength": 0, "maxLength": 20 },
        "closedByEmail": { "type": "string", "minLength": 3, "maxLength": 120 },
        "closedByName": { "type": "string", "minLength": 1, "maxLength": 100 },
        "totalStudents": { "type": "integer" },
        "promotedCount": { "type": "integer" },
        "repeatedCount": { "type": "integer" },
        "graduatedCount": { "type": "integer" },
        "withdrawnCount": { "type": "integer" },
        "classSummaries": { "type": "array" },
        "studentRecords": { "type": "array" },
        "managementEmails": { "type": "array" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["ownerId", "schoolId", "academicYear", "closedAtIso", "closedByEmail", "closedByName", "totalStudents", "promotedCount", "repeatedCount", "graduatedCount", "withdrawnCount", "classSummaries", "studentRecords", "createdAt"]
    },
    "AuditLog": {
      "title": "AuditLog",
      "description": "Journal d'audit hebdomadaire inaltérable (append-only) des actions et événements de sécurité.",
      "type": "object",
      "properties": {
        "ownerId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "schoolId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "weekKey": { "type": "string", "minLength": 7, "maxLength": 10, "pattern": "^[0-9]{4}-W[0-9]{2}$" },
        "category": { "type": "string", "enum": ["auth", "student", "grade", "bulletin", "classroom", "subject", "rbac", "settings", "security", "export", "archive"] },
        "severity": { "type": "string", "enum": ["info", "warning", "critical"] },
        "action": { "type": "string", "minLength": 2, "maxLength": 100 },
        "details": { "type": "string", "minLength": 1, "maxLength": 500 },
        "actorUid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "actorEmail": { "type": "string", "minLength": 3, "maxLength": 120 },
        "actorName": { "type": "string", "minLength": 1, "maxLength": 100 },
        "actorRole": { "type": "string", "enum": ["admin", "censeur", "secretaire", "teacher", "parent"] },
        "targetId": { "type": "string", "minLength": 0, "maxLength": 128 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["ownerId", "schoolId", "weekKey", "category", "severity", "action", "details", "actorUid", "actorEmail", "actorName", "actorRole", "createdAt"]
    }
  },
  "firestore": {
    "/schools/{schoolId}": {
      "schema": { "$ref": "#/entities/School" },
      "description": "Profil et informations complètes de l'établissement scolaire."
    },
    "/classrooms/{classroomId}": {
      "schema": { "$ref": "#/entities/Classroom" },
      "description": "Classes et divisions personnalisées (ex: 6ème A, 4ème B, 2nde CD)."
    },
    "/memberships/{membershipId}": {
      "schema": { "$ref": "#/entities/Membership" },
      "description": "Rôles et accès du censeur, secrétaire, enseignants et parents."
    },
    "/students/{studentId}": {
      "schema": { "$ref": "#/entities/Student" },
      "description": "Registre des élèves inscrits par classe/division."
    },
    "/studentLocks/{lockId}": {
      "schema": { "$ref": "#/entities/StudentLock" },
      "description": "Verrou déterministe par établissement et email élève bloquant les privilèges personnel."
    },
    "/subjects/{subjectId}": {
      "schema": { "$ref": "#/entities/Subject" },
      "description": "Matières et coefficients par cycle."
    },
    "/grades/{gradeId}": {
      "schema": { "$ref": "#/entities/Grade" },
      "description": "Notes des élèves (Interrogations, Devoir, Composition)."
    },
    "/bulletinRemarks/{remarkId}": {
      "schema": { "$ref": "#/entities/BulletinRemark" },
      "description": "Appréciations générales et décisions des bulletins trimestriels/semestriels."
    },
    "/messages/{messageId}": {
      "schema": { "$ref": "#/entities/Message" },
      "description": "Messagerie sécurisée entre direction, enseignants et parents."
    },
    "/notifications/{notificationId}": {
      "schema": { "$ref": "#/entities/Notification" },
      "description": "Alertes sur les notes, absences et annonces importantes."
    },
    "/academicArchives/{archiveId}": {
      "schema": { "$ref": "#/entities/AcademicArchive" },
      "description": "Archives annuelles des années scolaires clôturées."
    },
    "/auditLogs/{logId}": {
      "schema": { "$ref": "#/entities/AuditLog" },
      "description": "Journaux hebdomadaires inaltérables de sécurité et d'activité scolaire."
    }
  }
}
