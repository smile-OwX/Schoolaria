          !isStudentLockedEmailInSchool(incoming().schoolId, incoming().memberEmail)
        )
        && (
          isAdmin() ||
          (
            existing().ownerId == request.auth.uid &&
            incoming().diff(existing()).affectedKeys().hasOnly(['memberEmail', 'memberName', 'role', 'assignedClasses', 'assignedSubject', 'childStudentIds', 'managementEmails', 'updatedAt'])
          ) ||
          (
            isCenseurInSchool(existing().schoolId) &&
            existing().role in ['secretaire', 'teacher', 'parent'] &&
            incoming().role in ['secretaire', 'teacher', 'parent'] &&
            incoming().diff(existing()).affectedKeys().hasOnly(['memberEmail', 'memberName', 'role', 'assignedClasses', 'assignedSubject', 'childStudentIds', 'managementEmails', 'updatedAt'])
          ) ||
          (
            isCenseurInSchool(existing().schoolId) &&
            existing().role == 'censeur' &&
            incoming().role == 'censeur' &&
            incoming().diff(existing()).affectedKeys().hasOnly(['managementEmails', 'updatedAt'])
          ) ||
          (
            isSecretaireInSchool(existing().schoolId) &&
            existing().role == 'parent' &&
            incoming().role == 'parent' &&
            incoming().diff(existing()).affectedKeys().hasOnly(['childStudentIds', 'updatedAt'])
          )
        );
      allow delete: if isVerifiedUser() && isValidId(membershipId) && (
        existing().ownerId == request.auth.uid ||
        (isCenseurInSchool(existing().schoolId) && existing().role in ['secretaire', 'teacher', 'parent']) ||
        isAdmin()
      );
    }

    match /students/{studentId} {
