        && incoming().createdByEmail == authEmail()
        && 'createdByRole' in incoming()
        && incoming().audienceEmails.size() >= 1
        && incoming().read == false
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && schoolBelongsToOwner(incoming().schoolId, incoming().ownerId)
        && (
          (incoming().createdByRole == 'admin' && (incoming().ownerId == request.auth.uid || isAdmin())) ||
          (incoming().createdByRole == 'censeur' && isCenseurInSchool(incoming().schoolId)) ||
          (
            incoming().createdByRole == 'secretaire' &&
            isSecretaireInSchool(incoming().schoolId) &&
            audienceOnlySecretaireTargets(incoming().schoolId, incoming().audienceEmails)
          ) ||
          (
            incoming().createdByRole == 'teacher' &&
            canStaffWriteInSchool(incoming().schoolId, incoming().ownerId) &&
            !isManagementInSchool(incoming().schoolId) &&
            audienceOnlyLeadershipTargets(incoming().schoolId, incoming().audienceEmails)
          ) ||
          (
            incoming().createdByRole == 'parent' &&
            canWriteInSchool(incoming().schoolId, incoming().ownerId) &&
            !isManagementInSchool(incoming().schoolId) &&
            audienceOnlyCenseurTargets(incoming().schoolId, incoming().audienceEmails)
          )
        );
      allow update: if isVerifiedUser()
        && isValidId(notificationId)
        && isValidNotification(incoming())
        && (
          existing().ownerId == request.auth.uid ||
          authEmail() in existing().audienceEmails ||
          isCenseurInSchool(existing().schoolId) ||
          isAdmin()
        )
        && incoming().ownerId == existing().ownerId
        && incoming().schoolId == existing().schoolId
        && incoming().createdByEmail == existing().createdByEmail
        && (!('createdByRole' in existing()) || ('createdByRole' in incoming() && incoming().createdByRole == existing().createdByRole))
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          isAdmin() ||
          (
            existing().ownerId == request.auth.uid &&
            incoming().diff(existing()).affectedKeys().hasOnly(['read', 'dismissedByEmails', 'managementEmails', 'updatedAt'])
          ) ||
          incoming().diff(existing()).affectedKeys().hasOnly(['read', 'dismissedByEmails', 'updatedAt'])
        );
      allow delete: if isVerifiedUser() && isValidId(notificationId) && (
        existing().ownerId == request.auth.uid ||
        existing().createdByEmail == authEmail() ||
        isCenseurInSchool(existing().schoolId) ||
        (authEmail() in existing().audienceEmails && existing().audienceEmails.size() <= 1) ||
        isAdmin()
      );
    }

    match /academicArchives/{archiveId} {
      allow get: if isVerifiedUser() && isValidId(archiveId) && (
        existing().ownerId == request.auth.uid ||
        isManagementInSchool(existing().schoolId) ||
        isAdmin()
      );
      allow list: if isVerifiedUser() && (
        resource.data.ownerId == request.auth.uid ||
        ('managementEmails' in resource.data && authEmail() in resource.data.managementEmails)
      );
      allow create: if isVerifiedUser()
        && isValidId(archiveId)
        && isValidAcademicArchive(incoming())
        && incoming().ownerId == request.auth.uid
        && ownsExistingSchool(incoming().schoolId)
        && incoming().createdAt == request.time;
      allow update: if isVerifiedUser()
        && isValidId(archiveId)
        && isValidAcademicArchive(incoming())
        && (existing().ownerId == request.auth.uid || isCenseurInSchool(existing().schoolId) || isAdmin())
        && incoming().ownerId == existing().ownerId
        && incoming().schoolId == existing().schoolId
        && incoming().academicYear == existing().academicYear
        && incoming().closedAtIso == existing().closedAtIso
        && incoming().createdAt == existing().createdAt
        && incoming().diff(existing()).affectedKeys().hasOnly(['managementEmails']);
      allow delete: if isVerifiedUser() && isValidId(archiveId) && (existing().ownerId == request.auth.uid || isAdmin());
    }

    match /auditLogs/{logId} {
      allow get: if isVerifiedUser() && isValidId(logId) && (
        existing().ownerId == request.auth.uid ||
        isAdmin()
      );
      allow list: if isVerifiedUser() && (
        resource.data.ownerId == request.auth.uid
      );
      allow create: if isVerifiedUser()
        && isValidId(logId)
        && isValidAuditLog(incoming())
        && incoming().actorUid == request.auth.uid
        && incoming().actorEmail == authEmail()
        && incoming().createdAt == request.time
        && canWriteInSchool(incoming().schoolId, incoming().ownerId)
        && (
          incoming().actorRole == 'parent' ||
          (incoming().actorRole == 'teacher' && canStaffWriteInSchool(incoming().schoolId, incoming().ownerId)) ||
          (incoming().actorRole == 'censeur' && isCenseurInSchool(incoming().schoolId)) ||
          (incoming().actorRole == 'secretaire' && isSecretaireInSchool(incoming().schoolId)) ||
          (incoming().actorRole == 'admin' && (incoming().ownerId == request.auth.uid || isAdmin()))
        );
      allow update, delete: if false;
    }
  }
}
