    match /messages/{messageId} {
      allow get: if isVerifiedUser() && isValidId(messageId) && (
        existing().ownerId == request.auth.uid ||
        existing().senderEmail == authEmail() ||
        existing().recipientEmail == authEmail() ||
        isAdmin()
