      );
      allow list: if isVerifiedUser() && (
        resource.data.ownerId == request.auth.uid ||
        ('managementEmails' in resource.data && authEmail() in resource.data.managementEmails) ||
        ('parentEmail' in resource.data && resource.data.parentEmail == authEmail()) ||
        ('teacherEmails' in resource.data && authEmail() in resource.data.teacherEmails)
      );
      allow create: if isVerifiedUser()
        && isValidId(gradeId)
        && isValidGrade(incoming())
        && (
          incoming().ownerId == request.auth.uid ||
          (
            (
              isCenseurInSchool(incoming().schoolId) ||
              (!isStudentLockedInSchool(incoming().schoolId) && ('teacherEmails' in incoming() && authEmail() in incoming().teacherEmails))
            ) &&
            studentParentEmailMatches(incoming().studentId, incoming())
          )
        )
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && validStudentForWrite(incoming().studentId, incoming().schoolId, incoming().ownerId);
      allow update: if isVerifiedUser()
        && isValidId(gradeId)
        && isValidGrade(incoming())
        && incoming().ownerId == existing().ownerId
        && incoming().schoolId == existing().schoolId
        && incoming().studentId == existing().studentId
        && incoming().subjectId == existing().subjectId
        && incoming().trimester == existing().trimester
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          (
            (existing().ownerId == request.auth.uid || isAdmin()) &&
            incoming().diff(existing()).affectedKeys().hasOnly(['classe', 'subjectName', 'coef', 'int1', 'int2', 'devoir', 'compo', 'appreciation', 'parentEmail', 'teacherEmails', 'managementEmails', 'updatedAt'])
          ) ||
          (
            isCenseurInSchool(existing().schoolId) &&
            incoming().diff(existing()).affectedKeys().hasOnly(['classe', 'subjectName', 'coef', 'int1', 'int2', 'devoir', 'compo', 'appreciation', 'parentEmail', 'teacherEmails', 'managementEmails', 'updatedAt'])
          ) ||
          (
            isSecretaireInSchool(existing().schoolId) &&
            incoming().diff(existing()).affectedKeys().hasOnly(['classe', 'updatedAt'])
          ) ||
          (
            !isStudentLockedInSchool(existing().schoolId) &&
            ('teacherEmails' in existing() && authEmail() in existing().teacherEmails) &&
            incoming().diff(existing()).affectedKeys().hasOnly(['int1', 'int2', 'devoir', 'compo', 'appreciation', 'updatedAt'])
