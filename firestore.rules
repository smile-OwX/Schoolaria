    match /grades/{gradeId} {
      allow get: if isVerifiedUser() && isValidId(gradeId) && (
        existing().ownerId == request.auth.uid ||
        isManagementInSchool(existing().schoolId) ||
        ('parentEmail' in existing() && existing().parentEmail == authEmail()) ||
        (!isStudentLockedInSchool(existing().schoolId) && 'teacherEmails' in existing() && authEmail() in existing().teacherEmails) ||
