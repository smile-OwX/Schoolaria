        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isVerifiedUser()
        && isValidId(classroomId)
        && isValidClassroom(incoming())
        && (existing().ownerId == request.auth.uid || isManagementInSchool(existing().schoolId) || isAdmin())
        && incoming().ownerId == existing().ownerId
        && incoming().schoolId == existing().schoolId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          isAdmin() ||
          (
            (existing().ownerId == request.auth.uid || isCenseurInSchool(existing().schoolId) || isSecretaireInSchool(existing().schoolId)) &&
            incoming().diff(existing()).affectedKeys().hasOnly(['name', 'level', 'cycle', 'series', 'motif', 'accentColor', 'room', 'headTeacher', 'headTeacherEmail', 'slogan', 'closingDate', 'teacherEmails', 'memberEmails', 'managementEmails', 'updatedAt'])
          )
        );
      allow delete: if isVerifiedUser() && isValidId(classroomId) && (
        existing().ownerId == request.auth.uid ||
        isCenseurInSchool(existing().schoolId) ||
        isSecretaireInSchool(existing().schoolId) ||
